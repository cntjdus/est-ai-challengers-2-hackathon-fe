import { useEffect, useMemo, useRef, useState } from 'react'
import HomeHeader from '../components/home/HomeHeader'
import BottomNavigation from '../components/common/BottomNavigation'
import RecipeCard from '../components/recipe/RecipeCard'
import character from '../assets/hankkiloop-character.png'
import savingsCharacter from '../assets/recipe-savings-character.jpg'
import { CirclePlus, Flame, Search } from 'lucide-react'

const sources = [
  { id: 'ai', label: '냉큼이 추천', value: 'AI 추천 메뉴' },
  { id: 'youtube', label: '유튜브 레시피' },
  { id: 'blog', label: '블로그 레시피' },
  { id: 'fridge', label: '냉장고 파먹기' },
]
const quickRecipes = ['튜나김치덮밥', '계란말이', '알리오올리오', '두부조림']
const suggestedIngredients = ['대파', '두부', '양파']

const getSourceId = (source) =>
  sources.find((item) => (item.value ?? item.label) === source)?.id ?? 'ai'

const matchesSearch = (recipe, search) => {
  if (!search) return true
  const keyword = search.toLowerCase()
  return [recipe?.title, recipe?.ingredientSummary, recipe?.description]
    .filter(Boolean)
    .join(' ')
    .toLowerCase()
    .includes(keyword)
}

// Database catalog is supplied by App.
export default function Recipe({
  recipes = [],
  aiRecommendationIds = [],
  loading = false,
  error = '',
  onRetry,
  onNavigate,
  savedIds = [],
  onToggleSave,
  listState = {},
  onListStateChange = () => {},
  allergyNotice,
  saveLoading = false,
  busySaveIds = [],
}) {
  const [tab, setTab] = useState(listState.tab ?? 'recipes')
  const [search, setSearch] = useState(listState.search ?? '')
  const [draftSearch, setDraftSearch] = useState(listState.search ?? '')
  const [source, setSource] = useState(listState.category ?? 'AI 추천 메뉴')

  useEffect(() => {
    onListStateChange({ tab, search, category: source })
  }, [tab, search, source, onListStateChange])

  const pageRef = useRef(null)
  useEffect(() => {
    pageRef.current?.focus()
  }, [])

  const selectedSourceId = getSourceId(source)

  const sourceRecipes = useMemo(() => {
    if (selectedSourceId === 'ai') {
      if (!Array.isArray(aiRecommendationIds) || aiRecommendationIds.length === 0) {
        return recipes
      }

      const recipeById = new Map(recipes.map((recipe) => [String(recipe.id), recipe]))
      const recommended = aiRecommendationIds
        .map((id) => recipeById.get(String(id)))
        .filter(Boolean)

      return recommended.length > 0 ? recommended : recipes
    }

    const selectedSource = sources.find((item) => item.id === selectedSourceId)
    const expectedTag = selectedSource?.label

    return recipes.filter((recipe) => {
      const tags = Array.isArray(recipe?.tags) ? recipe.tags : []

      return (
        (expectedTag && tags.includes(expectedTag)) ||
        recipe?.sourceType === selectedSourceId
      )
    })
  }, [recipes, aiRecommendationIds, selectedSourceId])

  const visibleRecipes = useMemo(() => {
    const baseRecipes =
      tab === 'saved'
        ? recipes.filter((recipe) => savedIds.includes(recipe.id))
        : sourceRecipes

    return baseRecipes.filter((recipe) => matchesSearch(recipe, search))
  }, [tab, recipes, savedIds, sourceRecipes, search])

  const consumableIngredients = suggestedIngredients.filter((ingredient) =>
    recipes.some((recipe) => recipe.ingredientSummary?.includes(ingredient)),
  )
  const savingsIngredients = consumableIngredients.length
    ? consumableIngredients
    : suggestedIngredients

  const submitSearch = (event) => {
    event.preventDefault()
    setSearch(draftSearch.trim())
  }

  const selectQuickRecipe = (name) => {
    setDraftSearch(name)
    setSearch(name)
    setSource('AI 추천 메뉴')
  }

  const handleNotifications = () => {
    /* TODO: 알림 화면 연결 */
  }

  return (
    <div ref={pageRef} tabIndex={-1} className="relative mx-auto flex h-dvh w-full max-w-app flex-col overflow-hidden bg-[#fafcf9] outline-none">
      <HomeHeader pageLabel="레시피" onProfile={() => onNavigate('/mypage')} onNotifications={handleNotifications} />
      <main aria-label="레시피 탐색" className="min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 pt-6 pb-20">
        <p className="mb-3 text-xs text-[#64748b]">{allergyNotice}</p>
        <section className="flex items-center gap-3.5 rounded-3xl border border-[#e5ece7] bg-white p-4 shadow-[0_2px_8px_rgba(27,77,62,0.05)]">
          <div className="relative size-14 shrink-0 overflow-hidden rounded-2xl border border-[#bbf7d0] bg-[#d1fae5]"><img src={character} alt="한끼루프 냉장고 캐릭터" className="absolute top-[-12%] left-[-2%] w-[255%] max-w-none" /></div>
          <div><span className="rounded-full border border-[#a7f3d0]/70 bg-[#ecfdf5] px-2 py-0.5 text-[11px] font-bold text-[#047857]">냉큼이와 함께</span><h2 className="mt-1.5 text-base leading-6 text-[#1e293b]">오늘 어떤 요리를 만들어볼까요?</h2></div>
        </section>
        <div aria-label="레시피 보기" className="mt-4 grid grid-cols-2 gap-5">
          <button type="button" aria-pressed={tab === 'recipes'} onClick={() => { setTab('recipes'); setSearch(''); setDraftSearch('') }} className="border-b-[3px] border-transparent py-3 text-base text-[#839087] aria-pressed:border-[#007f5c] aria-pressed:text-[#007f5c]">레시피{tab === 'recipes' && <span className="ml-1 text-[#10b981]">•</span>}</button>
          <button type="button" aria-pressed={tab === 'saved'} onClick={() => setTab('saved')} className="border-b-[3px] border-transparent py-3 text-base text-[#839087] aria-pressed:border-[#007f5c] aria-pressed:text-[#007f5c]">스크랩 <span className="rounded-full bg-[#e9eefb] px-1.5 text-xs">{savedIds.length}</span></button>
        </div>

        {tab === 'recipes' && <>
          <div aria-label="레시피 출처" className="-mx-4 mt-6 flex gap-2.5 overflow-x-auto px-5 py-1">
            {sources.map((item) => <button key={item.id} type="button" aria-pressed={source === (item.value ?? item.label)} onClick={() => setSource(item.value ?? item.label)} className="shrink-0 whitespace-nowrap rounded-full bg-[#eff4ff] px-3.5 py-2 text-[13px] text-[#3c4a42] aria-pressed:bg-[#006c49] aria-pressed:font-bold aria-pressed:text-white">{item.label}</button>)}
          </div>
          <form role="search" onSubmit={submitSearch} className="mt-5 flex h-12 min-w-0 items-center gap-2 rounded-2xl bg-[#eff4ff] px-2.5">
            <Search aria-hidden="true" className="ml-1 size-4 shrink-0 text-[#6c7a71]" />
            <input aria-label="레시피 검색" value={draftSearch} onChange={(event) => setDraftSearch(event.target.value)} placeholder="먹고 싶은 요리나 식재료 검색 (예: 김치볶음밥)" className="min-w-0 flex-1 bg-transparent text-sm text-[#161c25] outline-none placeholder:text-[#b6c1ba]" />
            <button type="submit" className="flex h-9 shrink-0 items-center gap-1 rounded-xl bg-[#006c49] px-3 text-sm text-white"><Search aria-hidden="true" className="size-3.5" />검색</button>
          </form>
          <section aria-label="인기 간편 조합" className="mt-5">
            <div className="flex items-center justify-between gap-2"><h2 className="flex items-center gap-1 text-sm text-[#161c25]"><Flame aria-hidden="true" className="size-4 text-[#f97316]" />자취생 인기 간편 조합</h2><span className="shrink-0 text-[11px] text-[#839087]">터치하여 바로 탐색</span></div>
            <div className="-mx-4 mt-2 flex gap-2 overflow-x-auto px-5 pb-1">{quickRecipes.map((name) => <button key={name} type="button" onClick={() => selectQuickRecipe(name)} className="flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-[#eef1f1] bg-white px-3 py-2 text-sm text-[#3c4a42] shadow-sm"><CirclePlus aria-hidden="true" className="size-3.5 text-[#006c49]" />{name}</button>)}</div>
          </section>
          <section className="mt-7 flex min-w-0 items-center gap-3 rounded-2xl border border-[#dbe4f3] bg-[#eff4ff] p-4">
            <div className="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#006c49]/15"><img src={savingsCharacter} alt="" className="size-9 rounded-lg object-contain" /></div>
            <div className="min-w-0"><h2 className="text-[17px] leading-6 text-[#161c25]">예상 식비 절약 &amp; 소진 효과</h2><p className="mt-0.5 text-sm leading-[19px] text-[#3c4a42]">추천 메뉴로 냉장고 속 <span className="text-[#006c49]">{savingsIngredients.join(', ')}</span>를 알뜰하게 비워낼 수 있어요!</p></div>
          </section>
        </>}

        <section className="mt-7">
          <div className="mb-3 flex items-center justify-between gap-1">
            <h2 className="text-base text-[#1e293b]">{tab === 'saved' ? '스크랩한 레시피' : search ? search + ' 활용 레시피' : '냉장고 맞춤 추천 레시피'}<span className="ml-1 rounded-full bg-[#006c49] px-2 text-[11px] text-white">{visibleRecipes.length}선</span></h2>
            <span className="shrink-0 text-[10px] text-[#839087]">{tab === 'saved' ? '맞춤 추천순' : '소비기한 임박 우선'}</span>
          </div>
          <div className="flex flex-col gap-3">
            {loading && <p role="status">레시피를 불러오는 중…</p>}
            {!loading && error && <div role="alert"><p>{error}</p><button type="button" onClick={onRetry}>다시 불러오기</button></div>}
            {!loading && !error && visibleRecipes.map((recipe) => <RecipeCard saveDisabled={saveLoading || busySaveIds.includes(recipe.id)} key={recipe.id} recipe={recipe} onOpen={() => { onListStateChange({ tab, search, category: source }); onNavigate('/recipe/' + recipe.id) }} saved={savedIds.includes(recipe.id)} onToggleSave={() => onToggleSave(recipe.id)} />)}
            {saveLoading && tab === 'saved' && <p role="status">스크랩을 불러오는 중…</p>}
            {!saveLoading && !loading && !error && visibleRecipes.length === 0 && <p role="status" className="rounded-2xl bg-white px-4 py-8 text-center text-sm text-[#64748b]">{tab === 'saved' ? '스크랩한 레시피가 없습니다.' : recipes.length ? '검색 조건에 맞는 레시피가 없습니다.' : '등록된 레시피가 없거나 설정에 따라 모두 제외되었습니다.'}</p>}
          </div>
        </section>
      </main>
      <BottomNavigation onNavigate={onNavigate} />
    </div>
  )
}
