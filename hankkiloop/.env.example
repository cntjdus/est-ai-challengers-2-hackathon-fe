# Supabase project URL (Project Settings > API / Connect)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key only. Never use a secret key or service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy anon key is supported instead of the publishable key:
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
